{
    "job_name": "Stamp-Engraving-Processes",
    "firmware_version": "1.0.9.0",
    "autofocus": "off",
    "copies": 1,
    "processes": [
        {
            "_of": "engrave_process",
            "name": "P1 Engrave",
            "filter": {
                "_of": "color_filter",
                "colors": [
                    "blue",
                    "cyan",
                    "lime",
                    "yellow"
                ]
            },
            "speed": 100,
            "power": 60,
            "air_assist": false,
            "cycles": 1,
            "laser_type": "co2",
            "offset": 0,
            "resolution": 500,
            "dithering": "grayscale_3d",
            "unidirectional": false,
            "precision_sync": true,
            "engrave_direction": "up",
            "operations": [
                {
                    "_of": "invert"
                },
                {
                    "_of": "threshold",
                    "value": 0.01
                },
                {
                    "_of": "dilate",
                    "distance": "0.01in"
                },
                {
                    "_of": "distance_transform",
                    "distance": "0.05in"
                },
                {
                    "_of": "map",
                    "value_map": [
                        [
                            0.4,
                            0.5
                        ],
                        [
                            0.6,
                            0.5
                        ]
                    ],
                    "interpolate_type": {
                        "_of": "linear"
                    }
                },
                {
                    "_of": "invert"
                },
                {
                    "_of": "path_mask",
                    "mask": {
                        "_of": "color_filter",
                        "colors": [
                            "magenta"
                        ]
                    },
                    "mask_operations": [
                        {
                            "_of": "threshold",
                            "value": 0.01
                        },
                        {
                            "_of": "dilate",
                            "distance": "0.05in"
                        }
                    ]
                }
            ]
        },
        {
            "_of": "vector_process",
            "name": "P2 Vector",
            "filter": {
                "_of": "color_filter",
                "colors": [
                    "red"
                ]
            },
            "speed": 100,
            "power": 25,
            "frequency": 100,
            "laser_type": "co2",
            "cycles": 1,
            "offset": 0.0,
            "beziers": true,
            "air_assist": false,
            "vector_sorting": "off"
        }
    ]
}