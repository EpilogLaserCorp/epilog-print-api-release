{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsGeneric",
  "type": "object",
  "properties": {
    "autofocus": {
      "type": "boolean"
    },
    "copies": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 1
    },
    "generic_font_families": {
      "$ref": "#/$defs/GenericFontFamilies",
      "default": {
        "_of": "system_defaults"
      }
    },
    "job_name": {
      "type": "string",
      "maxLength": 255,
      "minLength": 1
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProcessGeneric"
      },
      "minItems": 1
    },
    "svg_origin": {
      "$ref": "#/$defs/SvgOrigin",
      "default": {
        "_of": "zero"
      }
    }
  },
  "required": [
    "job_name",
    "copies",
    "autofocus",
    "processes"
  ],
  "$defs": {
    "AttributeFilter": {
      "type": "object",
      "properties": {
        "attribute": {
          "$ref": "#/$defs/AttributeType"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "attribute"
      ]
    },
    "AttributeType": {
      "type": "string",
      "enum": [
        "all",
        "stroke",
        "fill"
      ]
    },
    "ClosedPathLaserSide": {
      "description": "Defines how the laser side is determined for closed paths.",
      "oneOf": [
        {
          "description": "The outside of the path is the side that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "outside"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The inside of the path is the side that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "inside"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "right_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The negative cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "left_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "Filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "all_filter"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "color_filter"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "_of",
            "colors"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "stroke_filter"
            }
          },
          "$ref": "#/$defs/StrokeFilter",
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "attribute_filter"
            },
            "attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttributeFilter"
              }
            }
          },
          "required": [
            "_of",
            "attributes"
          ]
        }
      ]
    },
    "GenericFontFamilies": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "epilog_defaults"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "system_defaults"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "single_named"
            },
            "font_family": {
              "type": "string"
            }
          },
          "required": [
            "_of",
            "font_family"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "named"
            },
            "cursive_family": {
              "type": "string"
            },
            "fantasy_family": {
              "type": "string"
            },
            "monospace_family": {
              "type": "string"
            },
            "sans_serif_family": {
              "type": "string"
            },
            "serif_family": {
              "type": "string"
            }
          },
          "required": [
            "_of",
            "serif_family",
            "sans_serif_family",
            "cursive_family",
            "fantasy_family",
            "monospace_family"
          ]
        }
      ]
    },
    "HatchPattern": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float",
              "maximum": 100.0,
              "minimum": 1.0
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "passes": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "pattern_type": {
          "$ref": "#/$defs/HatchPatternType"
        },
        "power": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "speed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float",
              "maximum": 100.0,
              "minimum": 0.01
            }
          ]
        },
        "waveform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 15,
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "name",
        "pattern_type",
        "speed",
        "power",
        "frequency",
        "passes"
      ]
    },
    "HatchPatternType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "sweep"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "s_sweep"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "unidirectional"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "outline"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "HatchProcessGeneric": {
      "type": "object",
      "properties": {
        "cycles": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "focus": {
          "description": "The depth to which we want to focus. Must be specified iff auto focus is enabled.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "isolate_shapes": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "optimize_hatch_sort": {
          "type": "boolean",
          "default": true
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HatchPattern"
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "filter",
        "cycles",
        "patterns",
        "isolate_shapes"
      ]
    },
    "Kerf": {
      "type": "object",
      "properties": {
        "line_join": {
          "$ref": "#/$defs/LineJoin"
        },
        "offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        }
      },
      "required": [
        "offset",
        "line_join"
      ]
    },
    "LaserSideGeneric": {
      "description": "Laser-side can essentially be thought of as the side of an artwork path that we would like to laser. As such, this represents the side of the path that we would like to offset towards. This struct specifies the side of the line for offsetting paths and will eventually be used for lead-in and lead-out as well. Note: When lead-in and lead-out are implemented, make the `kerf_offset` field optional.",
      "type": "object",
      "properties": {
        "closed": {
          "$ref": "#/$defs/ClosedPathLaserSide"
        },
        "kerf": {
          "$ref": "#/$defs/Kerf"
        },
        "open": {
          "$ref": "#/$defs/OpenPathLaserSide"
        },
        "overrides": {
          "description": "This specifies which objects will have their laser sides flipped as such: - Outside <-> Inside - RightHandRule <-> LeftHandRule",
          "anyOf": [
            {
              "$ref": "#/$defs/Filter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "closed",
        "open",
        "kerf"
      ]
    },
    "LineJoin": {
      "description": "The type of joining used when offsetting paths.",
      "oneOf": [
        {
          "description": "Joins the ends of the lines with a simple bevel.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "bevel"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Joins the ends of the lines with a circular arc.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "round"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Joins the ends of the lines with a miter.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "miter"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "OpenPathLaserSide": {
      "description": "Defines how the laser side is determined for open paths.",
      "oneOf": [
        {
          "description": "The cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "right_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The negative cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "left_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "ProcessGeneric": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "vector_process"
            }
          },
          "$ref": "#/$defs/VectorProcessGeneric",
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "hatch_process"
            }
          },
          "$ref": "#/$defs/HatchProcessGeneric",
          "required": [
            "_of"
          ]
        }
      ]
    },
    "StrokeFilter": {
      "type": "object",
      "properties": {
        "op": {
          "$ref": "#/$defs/StrokeFilterOp"
        },
        "width": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        }
      },
      "required": [
        "width",
        "op"
      ]
    },
    "StrokeFilterOp": {
      "type": "string",
      "enum": [
        "<",
        "<=",
        ">",
        ">=",
        "==",
        "!="
      ]
    },
    "SvgOrigin": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "zero"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "half_table_size"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "view_rect_top_left"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "view_rect_center"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "custom"
            },
            "x": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            },
            "y": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "x",
            "y"
          ]
        }
      ]
    },
    "VectorProcessGeneric": {
      "type": "object",
      "properties": {
        "cycles": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "focus": {
          "description": "The depth to which we want to focus. Must be specified iff auto focus is enabled.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float",
              "maximum": 100.0,
              "minimum": 1.0
            }
          ]
        },
        "laser_side": {
          "anyOf": [
            {
              "$ref": "#/$defs/LaserSideGeneric"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "optimize_cycles": {
          "type": "boolean",
          "default": true
        },
        "power": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "speed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float",
              "maximum": 100.0,
              "minimum": 0.01
            }
          ]
        },
        "vector_sorting": {
          "$ref": "#/$defs/VectorSorting"
        },
        "waveform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 15,
              "minimum": 0
            }
          ]
        }
      },
      "required": [
        "name",
        "filter",
        "cycles",
        "speed",
        "power",
        "frequency",
        "vector_sorting"
      ]
    },
    "VectorSorting": {
      "type": "string",
      "enum": [
        "off",
        "optimize",
        "inside_out"
      ]
    }
  }
}