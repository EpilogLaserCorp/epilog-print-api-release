{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SettingsGeneric",
  "type": "object",
  "properties": {
    "autofocus": {
      "type": "boolean"
    },
    "copies": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 1
    },
    "engrave_direction": {
      "description": "The direction that all engrave processes should move in.",
      "$ref": "#/$defs/EngravingDirection"
    },
    "engrave_resolution": {
      "description": "The resolution at which all engrave processes should render.",
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "generic_font_families": {
      "$ref": "#/$defs/GenericFontFamilies",
      "default": {
        "_of": "system_defaults"
      }
    },
    "job_alignment": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobAlignment"
        },
        {
          "type": "null"
        }
      ]
    },
    "job_name": {
      "type": "string",
      "maxLength": 255,
      "minLength": 1
    },
    "processes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ProcessGeneric"
      },
      "minItems": 1
    },
    "svg_origin": {
      "$ref": "#/$defs/SvgOrigin",
      "default": {
        "_of": "zero"
      }
    }
  },
  "required": [
    "job_name",
    "copies",
    "autofocus",
    "engrave_resolution",
    "engrave_direction",
    "processes"
  ],
  "$defs": {
    "AttributeFilter": {
      "type": "object",
      "properties": {
        "attribute": {
          "$ref": "#/$defs/AttributeType"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "attribute"
      ]
    },
    "AttributeType": {
      "type": "string",
      "enum": [
        "all",
        "stroke",
        "fill"
      ]
    },
    "CenteringOffset": {
      "type": "object",
      "properties": {
        "x": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "y": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "CenteringPoint": {
      "type": "string",
      "enum": [
        "custom",
        "center_center",
        "left_center",
        "right_center",
        "center_top",
        "center_bottom",
        "top_left",
        "top_right",
        "bottom_left",
        "bottom_right"
      ]
    },
    "ClosedPathLaserSide": {
      "description": "Defines how the laser side is determined for closed paths.",
      "oneOf": [
        {
          "description": "The outside of the path is the side that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "outside"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The inside of the path is the side that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "inside"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "right_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The negative cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "left_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "DitheringType": {
      "type": "string",
      "enum": [
        "none",
        "standard",
        "floyd_steinberg",
        "jarvis",
        "stucki",
        "bayer",
        "brighten",
        "grayscale_3d"
      ]
    },
    "EngraveOperationGeneric": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "threshold"
            },
            "value": {
              "type": "number",
              "format": "float",
              "maximum": 1.0,
              "minimum": 0.0
            }
          },
          "required": [
            "_of",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "invert"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "dilate"
            },
            "distance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "distance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "distance_transform"
            },
            "distance": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "distance"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "image_mask"
            },
            "mask": {
              "$ref": "#/$defs/Filter"
            },
            "mask_operations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EngraveOperationGeneric"
              }
            }
          },
          "required": [
            "_of",
            "mask"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "path_mask"
            },
            "mask": {
              "$ref": "#/$defs/Filter"
            },
            "mask_operations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/EngraveOperationGeneric"
              }
            }
          },
          "required": [
            "_of",
            "mask"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "map"
            },
            "interpolate_type": {
              "$ref": "#/$defs/InterpolateType"
            },
            "value_map": {
              "type": "array",
              "items": {
                "type": "array",
                "maxItems": 2,
                "minItems": 2,
                "prefixItems": [
                  {
                    "type": "number",
                    "format": "float"
                  },
                  {
                    "type": "number",
                    "format": "float"
                  }
                ]
              }
            }
          },
          "required": [
            "_of",
            "interpolate_type"
          ]
        }
      ]
    },
    "EngraveProcessGeneric": {
      "type": "object",
      "properties": {
        "air_assist": {
          "description": "Whether or not the air assist solenoid will be activated. This option is available for the Legend series, but not for the Fibermark, and Zing series. As such, the validation stage may throw an error if this option is specified.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cycles": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "dithering": {
          "$ref": "#/$defs/DitheringType"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "focus": {
          "description": "The depth to which we want to focus. Must be specified iff auto focus is enabled. This option is available for the Fibermark and Zing series, but not for the Legend series. As such, the validation stage may throw an error if this option is specified.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "frequency": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 5000,
              "minimum": 10
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EngraveOperationGeneric"
          }
        },
        "power": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "precision_sync": {
          "type": "boolean"
        },
        "speed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 1
            }
          ]
        }
      },
      "required": [
        "name",
        "filter",
        "cycles",
        "dithering",
        "speed",
        "power",
        "precision_sync"
      ]
    },
    "EngravingDirection": {
      "type": "string",
      "enum": [
        "up",
        "down"
      ]
    },
    "Filter": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "all_filter"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "color_filter"
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "_of",
            "colors"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "stroke_filter"
            }
          },
          "$ref": "#/$defs/StrokeFilter",
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "attribute_filter"
            },
            "attributes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/AttributeFilter"
              }
            }
          },
          "required": [
            "_of",
            "attributes"
          ]
        }
      ]
    },
    "GenericFontFamilies": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "epilog_defaults"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "system_defaults"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "single_named"
            },
            "font_family": {
              "type": "string"
            }
          },
          "required": [
            "_of",
            "font_family"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "named"
            },
            "cursive_family": {
              "type": "string"
            },
            "fantasy_family": {
              "type": "string"
            },
            "monospace_family": {
              "type": "string"
            },
            "sans_serif_family": {
              "type": "string"
            },
            "serif_family": {
              "type": "string"
            }
          },
          "required": [
            "_of",
            "serif_family",
            "sans_serif_family",
            "cursive_family",
            "fantasy_family",
            "monospace_family"
          ]
        }
      ]
    },
    "HatchPattern": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 5000,
              "minimum": 10
            }
          ]
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "passes": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "pattern_type": {
          "$ref": "#/$defs/HatchPatternType"
        },
        "power": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 0
            }
          ]
        },
        "speed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer",
              "format": "uint16",
              "maximum": 100,
              "minimum": 1
            }
          ]
        }
      },
      "required": [
        "name",
        "pattern_type",
        "speed",
        "power",
        "frequency",
        "passes"
      ]
    },
    "HatchPatternType": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "sweep"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "s_sweep"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "unidirectional"
            },
            "angle": {
              "type": "number",
              "format": "float",
              "maximum": 360.0,
              "minimum": -360.0
            },
            "spacing": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number",
                  "format": "float"
                }
              ]
            }
          },
          "required": [
            "_of",
            "spacing",
            "angle"
          ]
        },
        {
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "outline"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "HatchProcessGeneric": {
      "type": "object",
      "properties": {
        "air_assist": {
          "description": "Whether or not the air assist solenoid will be activated. This option for the Legend series, but not for the Fibermark and Zing series. As such, the validation stage may throw an error if this option is specified.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "cycles": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "filter": {
          "$ref": "#/$defs/Filter"
        },
        "focus": {
          "description": "The depth to which we want to focus. Must be specified iff auto focus is enabled. This option is available for the Fibermark and Zing series, but not for the Legend series. As such, the validation stage may throw an error if this option is specified.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        },
        "isolate_shapes": {
          "type": "boolean"
        },
        "name": {
          "type": "string",
          "maxLength": 255,
          "minLength": 1
        },
        "optimize_hatch_sort": {
          "type": "boolean",
          "default": true
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HatchPattern"
          },
          "minItems": 1
        }
      },
      "required": [
        "name",
        "filter",
        "cycles",
        "patterns",
        "isolate_shapes"
      ]
    },
    "InterpolateType": {
      "description": "Defines how values in between the map's `value_map` points are treated.",
      "oneOf": [
        {
          "description": "Linearly interpolates between the nearest input value below and the nearest input value above the specified input.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "linear"
            },
            "max": {
              "description": "The value that 1 maps to if not specified in the `value_map`.",
              "type": "number",
              "format": "float",
              "default": 1.0,
              "maximum": 1.0,
              "minimum": 0.0
            },
            "min": {
              "description": "The value that 0 maps to if not specified in the `value_map`.",
              "type": "number",
              "format": "float",
              "default": 0.0,
              "maximum": 1.0,
              "minimum": 0.0
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Chooses the mapping to the nearest input value below the specified input.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "nearest_below"
            },
            "min": {
              "description": "The value that 0 maps to if not specified in the `value_map`.",
              "type": "number",
              "format": "float",
              "default": 0.0,
              "maximum": 1.0,
              "minimum": 0.0
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Chooses the mapping to the nearest input value above the specified input.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "nearest_above"
            },
            "max": {
              "description": "The value that 1 maps to if not specified in the `value_map`.",
              "type": "number",
              "format": "float",
              "default": 1.0,
              "maximum": 1.0,
              "minimum": 0.0
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "JobAlignment": {
      "type": "object",
      "properties": {
        "centering_point": {
          "$ref": "#/$defs/CenteringPoint"
        },
        "offset": {
          "anyOf": [
            {
              "$ref": "#/$defs/CenteringOffset"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "centering_point"
      ]
    },
    "Kerf": {
      "type": "object",
      "properties": {
        "line_join": {
          "$ref": "#/$defs/LineJoin"
        },
        "offset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number",
              "format": "float"
            }
          ]
        }
      },
      "required": [
        "offset",
        "line_join"
      ]
    },
    "LaserSideGeneric": {
      "description": "Laser-side can essentially be thought of as the side of an artwork path that we would like to laser. As such, this represents the side of the path that we would like to offset towards. This struct specifies the side of the line for offsetting paths and will eventually be used for lead-in and lead-out as well. Note: When lead-in and lead-out are implemented, make the `kerf_offset` field optional.",
      "type": "object",
      "properties": {
        "closed": {
          "$ref": "#/$defs/ClosedPathLaserSide"
        },
        "kerf": {
          "$ref": "#/$defs/Kerf"
        },
        "open": {
          "$ref": "#/$defs/OpenPathLaserSide"
        },
        "overrides": {
          "description": "This specifies which objects will have their laser sides flipped as such: - Outside <-> Inside - RightHandRule <-> LeftHandRule",
          "anyOf": [
            {
              "$ref": "#/$defs/Filter"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "closed",
        "open",
        "kerf"
      ]
    },
    "LineJoin": {
      "description": "The type of joining used when offsetting paths.",
      "oneOf": [
        {
          "description": "Joins the ends of the lines with a simple bevel.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "bevel"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Joins the ends of the lines with a circular arc.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "round"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "Joins the ends of the lines with a miter.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "miter"
            }
          },
          "required": [
            "_of"
          ]
        }
      ]
    },
    "OpenPathLaserSide": {
      "description": "Defines how the laser side is determined for open paths.",
      "oneOf": [
        {
          "description": "The cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
              "type": "string",
              "const": "right_hand_rule"
            }
          },
          "required": [
            "_of"
          ]
        },
        {
          "description": "The negative cross product of the direction of the path with a vector pointing out of the screen gives the direction that will be lased.",
          "type": "object",
          "properties": {
            "_of": {
